{
  "name": "reels-flow",
  "description": "Watch Instagram Reels hands-free.",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "store-assets": "bun run build:chrome && bun scripts/store-assets/capture.ts && bun scripts/store-assets/shots.ts",
    "store-video": "bun run build:chrome && bun scripts/store-video/render.ts --jobs 5"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "cheerio": "1.2.0",
    "domhandler": "6.0.1",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}
