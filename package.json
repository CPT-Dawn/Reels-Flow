{
  "name": "reels-flow",
  "description": "Watch Instagram Reels hands-free.",
  "private": true,
  "version": "3.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}
